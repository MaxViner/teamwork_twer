# AI-провайдер для описания объектов и финального поискового промпта.
#
# Бесплатный ключ Google Gemini: https://aistudio.google.com/apikey
# Скопируйте этот файл в backend/.env и заполните AI_API_KEY.
# После изменения ключа перезапустите backend.

AI_API_PROVIDER=gemini
AI_API_KEY=

# Можно перечислить несколько моделей через запятую:
# при ошибке 400/404 клиент попробует следующую.
AI_API_MODEL=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# Необязательно: свой base URL (например, прокси).
# AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

AI_API_TIMEOUT=60

# Искать похожие объекты в интернете через grounding Gemini.
# Сам кадр в поисковик не загружается: поиск идёт по описанию.
AI_ENABLE_WEB_SEARCH=true

# Альтернатива: OpenRouter с бесплатными моделями.
# AI_API_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# AI_API_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
